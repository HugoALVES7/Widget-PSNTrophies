          }
        }
      }
    },
    "Sign Out": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se déconnecter"
          }
        }
      }
    },
    "Sign in to your account on ": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte-toi à ton compte sur "
          }
        }
      }
    },
    "Silver": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Argent"
          }
        }
      }
    },
    "The token is only sent to Sony’s servers. The app only keeps a refresh token (valid for about 2 months), stored on this Mac.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeton n'est envoyé qu'aux serveurs de Sony. L'app ne garde qu'un jeton de rafraîchissement (valable environ 2 mois), stocké sur ce Mac."
          }
        }
      }
    },
    "To add the widget: right-click the desktop → Edit Widgets… → search for “Widget PSNTrophies”.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour ajouter le widget : clic droit sur le bureau → Modifier les widgets… → cherche « Widget PSNTrophies »."
          }
        }
      }
    },
    "Widget PSNTrophies": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget PSNTrophies"
          }
        }
      }
    },
    "Your level, platinum, gold, silver and bronze trophies, and your recent games.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton niveau, tes trophées platine, or, argent, bronze et tes jeux récents."
          }
        }
      }
    },
    "average": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "moyenne"
          }
        }
