    "Connect your PlayStation account": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte ton compte PlayStation"
          }
        }
      }
    },
    "Connected — the widget updates on its own.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté — le widget se met à jour tout seul."
          }
        }
      }
    },
    "Copy the “npsso” value (64 characters) or the whole page, and paste it here:": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie la valeur de « npsso » (64 caractères) ou toute la page, et colle-la ici :"
          }
        }
      }
    },
    "Error %lld while contacting %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreur %lld en contactant %@."
          }
        }
      }
    },
    "Gold": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Or"
          }
        }
      }
    },
    "In the same browser, open ": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le même navigateur, ouvre "
          }
        }
      }
    },
    "Invalid or expired NPSSO token. Sign in again on playstation.com and get a new token.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeton NPSSO invalide ou expiré. Reconnecte-toi sur playstation.com et récupère un nouveau jeton."
          }
        }
      }
    },
    "LEVEL": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NIVEAU"
          }
        }
      }
    },
    "Last updated: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernière mise à jour : %@"
          }
        }
      }
    },
    "My profile": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mon profil"
          }
        }
      }
    },
