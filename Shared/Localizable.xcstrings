      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeton NPSSO"
          }
        }
      }
    },
    "Not connected. Open the Widget PSNTrophies app to sign in.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas connecté. Ouvre l'app Widget PSNTrophies pour te connecter."
          }
        }
      }
    },
    "Open the Widget PSNTrophies app to sign in.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre l'app Widget PSNTrophies pour te connecter."
          }
        }
      }
    },
    "Platinum": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Platine"
          }
        }
      }
    },
    "PlayStation session expired. Sign in again from the app.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Session PlayStation expirée. Reconnecte-toi depuis l'app."
          }
        }
      }
    },
    "RECENT": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RÉCEMMENT"
          }
